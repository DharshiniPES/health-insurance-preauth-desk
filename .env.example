# Application Settings
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# LLM Provider Configuration ("stub", "gemini", or "ollama")
LLM_PROVIDER=stub
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=gemini-1.5-flash

# Multi-Agent Loop Bounds (A1)
MAX_AGENT_STEPS=6
MAX_TOOL_CALLS=8
WALL_CLOCK_TIMEOUT_SEC=25.0

# Resilience & Circuit Breaker (A5)
CB_FAIL_THRESHOLD=3
CB_RESET_TIMEOUT_SEC=30.0
CALL_TIMEOUT_SEC=8.0
MAX_RETRIES=3

# Caching & Rate Limiting (D7)
ENABLE_CACHE=true
CACHE_TTL_SEC=3600
RATE_LIMIT_PER_MINUTE=60

# SLO & Benchmarking (D6)
SLO_P95_SECONDS=2.5

# Prompt Artifact Version (L2)
ACTIVE_PROMPT_VERSION=v2

# Redis Broker (Docker / Production)
REDIS_URL=redis://localhost:6379/0
